<?xml version="1.0" encoding="utf-8"?>
<!-- The account file holds secrets sealed by this device's Keystore key, which backups and transfers cannot carry. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="jask-account.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="jask-account.json" />
    </device-transfer>
</data-extraction-rules>
