<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets Android's sampling profiler (simpleperf) and Perfetto profile the app from the shell,
     so performance can be measured on the non-debuggable -PjaskPerf build. Release builds never carry this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable android:shell="true" tools:targetApi="29" />
    </application>
</manifest>
